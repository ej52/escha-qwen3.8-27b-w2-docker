# ============================================================
# Qwen3.8-27B-Escha-W2 · Docker Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── HuggingFace ──────────────────────────────────────────────
# Required only if the model repo is gated.
HF_TOKEN=

# ── Model ────────────────────────────────────────────────────
# Local path (inside the container) where the model weights live.
# Maps to the ./models directory you mount.
MODEL=/models/Qwen3.8-27B-Escha-W2

# Displayed model name on the OpenAI-compatible API.
SERVED_NAME=Qwen3.8-27B-Escha-W2

# ── Escha Runtime ────────────────────────────────────────────
# Kernel variant. Use "blackwell" for RTX 30xx / 40xx GPUs
# (Ampere / Ada Lovelace). Do NOT change unless you know why.
ESCHA_ROUTE=blackwell

# ── Memory & Context ─────────────────────────────────────────
# GPU memory fraction reserved for the model (0.0–1.0).
# 0.88 leaves headroom for KV-cache + activations on a 24 GB card.
MEM=0.88

# Maximum context length in tokens. 131072 = 128 k tokens.
CTXLEN=131072

# Maximum simultaneous requests. Keep at 1 for a single-user
# local setup; raise only if you have >24 GB VRAM.
MAXREQ=1

# Mamba-specific tuning (internal EschaLabs parameter).
MAXMAMBA=2

# Prefill chunk size in tokens. Larger = faster prefill,
# higher peak VRAM. 2048 is safe for 24 GB.
CHUNK=2048

# Enable INT8 KV-cache. "on" saves ~20 % VRAM at negligible
# quality cost.
INT8=on

# ── Server ───────────────────────────────────────────────────
# Bind address inside the container (leave as-is).
HOST=0.0.0.0
